{
  "name": "koter-extratores",
  "version": "0.6.0",
  "private": true,
  "description": "Extracao de dados de documentos de seguradoras (PDF de apolice e proposta) para a renovacao do Koter. Puro: sem rede, sem portal, sem sessao.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "layout": "tsx scripts/layout.ts",
    "respostas": "tsx scripts/respostas.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
